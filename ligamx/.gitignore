# Caché cruda de ESPN: se regenera con datos/espn_descarga.py
datos/cache/
# Cachés y predicciones del modelado: se regeneran con el arnés
modelo/cache/
modelo/pred/*.parquet
__pycache__/
.pytest_cache/
*.log

# Motor en vivo: candados, temporales y repeticiones de prueba
salidas/*.lock
salidas/.*.tmp
salidas/vivo_prueba*
# El documento en vivo se reescribe en cada consulta durante un partido: se regenera con vivo.py una-vez
salidas/vivo.json
salidas/vivo_eventos.jsonl
salidas/vivo_estado.json
salidas/vivo_relevo.json
